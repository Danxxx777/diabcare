# Copiar a `.env` o generar con:
#   py -3 scripts/generar_env_local.py
# Nunca subas `.env` al repositorio.

DIABCARE_JWT_SECRET=cambiar-en-produccion
DIABCARE_PIPELINE_KEY=cambiar-clave-pipeline
DIABCARE_BOOTSTRAP_ADMIN=1
DIABCARE_JWT_HOURS=4
DIABCARE_COOKIE_SECURE=0

POCKETBASE_URL=http://localhost:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
POCKETBASE_COLLECTION=diabetes_dataset

MINIO_BUCKET=diabetes-data
MINIO_STAGE_PATH=stage/

AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=diabcare_elt

# URL que ven los QR (informes y cobro). Sin esto, el QR usa la IP de tu Wi‑Fi
# y solo funciona en la misma red. Para que cualquiera (datos móviles) pueda
# escanear: .\scripts\tunel-publico.ps1  o pega la URL en Configuración → Sistema.
DIABCARE_PUBLIC_URL=

# Stripe Checkout (modo test: sk_test_… / pk_test_…). Vacío = cobro en caja.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
